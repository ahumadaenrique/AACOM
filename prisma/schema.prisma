generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// SQLite does not support Enums, so we use String validation in app logic
// enum Role { ... } replaced by Strings

model CommissionLedger {
  id                 String   @id @default(cuid())
  sellerId           String
  seller             User     @relation("SellerCommissions", fields: [sellerId], references: [id])
  agencyId           String?
  stripeChargeId     String?
  description        String
  originalPrice      Float
  amountPaid         Float
  discountPercentage Float
  commissionEarned   Float
  status             String   @default("PENDING") // PENDING, PAID
  level              Int      @default(1) // 1 = Venta Directa, 2 = 2da gen (20%), 3 = 3ra gen (10%)
  sourceAgencyId     String?  // Opcional, para saber de dónde se originó el pago (útil en niveles 2 y 3)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Agency {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  logoUrl             String?
  primaryColor        String?   @default("#4f46e5")
  secondaryColor      String?
  stripeCustomerId    String?
  subscriptionStatus  String?   @default("active")
  subscriptionEndDate DateTime?
  referredByAgencyId  String?
  active              Boolean   @default(true)

  users              User[]
  clients            Client[]
  policies           Policy[]
  adnDiagnostics     AdnDiagnostic[]
  activityLogs       ActivityLog[]
  documentPacks      AgencyDocumentPack[]
  agencyDocuments    AgencyDocument[]
  dailyRecords       DailyRecord[]
  cotizaciones       Cotizacion[]
  performanceReviews PerformanceReview[]
  knowledgeDocuments KnowledgeDocument[]
  tickets            Ticket[]
  pollVotes          PollVote[]
  contents           Content[]
  autocompleteAgents Agent[]

  purchasedSeats Int @default(0)
  allowLiteAgents Boolean @default(false)
  
  // WhatsApp Planner Feature Config
  enableWhatsAppPlanner Boolean @default(false)
  whatsAppPlannerPhones String? // Almacenará hasta 2 números, separados por comas
  whatsAppPlannerAgents String? // IDs de agentes permitidos, separados por comas

  // Affiliate System
  referredById   String?
  referrer       User?    @relation("AgencyReferrer", fields: [referredById], references: [id])
  discountLocked Boolean? @default(false)

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  DevelopmentPlanDay DevelopmentPlanDay[]
}

model DiscountCode {
  id                 String    @id @default(cuid())
  code               String    @unique
  discountPercentage Float
  maxUses            Int?
  uses               Int       @default(0)
  expiresAt          DateTime? // Nueva propiedad para límite de tiempo
  active             Boolean   @default(true)

  sellerId String?
  seller   User?   @relation("SellerDiscountCodes", fields: [sellerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                 String    @id @default(cuid())
  agencyId           String?
  agency             Agency?   @relation(fields: [agencyId], references: [id])
  name               String?
  email              String    @unique
  password           String?
  image              String?
  role               String    @default("AGENTE") // Changed from Enum Role to String
  phone              String? // Teléfono del usuario/agente
  phoneVerified      Boolean   @default(false) // Candado de verificación SMS
  active             Boolean   @default(true) // Estatus activo/inactivo para restringir acceso
  birthDate          DateTime? // Fecha de nacimiento del agente para overlay de cumpleaños
  mustChangePassword Boolean   @default(false) // Flag de seguridad para forzar cambio de contraseña temporal

  // Términos y Condiciones
  termsAccepted   Boolean   @default(false) // Candado legal de primer acceso
  termsAcceptedAt DateTime? // Evidencia de firma

  // Affiliate System
  sellerCommissionRate Float?             @default(40)
  referredAgencies     Agency[]           @relation("AgencyReferrer")
  discountCodes        DiscountCode[]     @relation("SellerDiscountCodes")
  commissions          CommissionLedger[] @relation("SellerCommissions")

  // Redes Sociales (Opcional)
  instagram String?
  facebook  String?
  linkedin  String?
  twitter   String?

  // Datos Adicionales (Opcional)
  insurances   String? // Aseguradoras con las que trabaja
  favoriteBook String? // Libro favorito
  hobby        String? // Pasatiempo
  brandColor   String? // Color corporativo individual del Agente
  brandLogo    String? // Logo corporativo individual del Agente

  // Credenciales y Registros
  promotoriaJoinDate DateTime? // Fecha de Alta en promotoría (Admin only)
  cedulaValidUntil   DateTime? // Vigencia de cédula hasta
  rcPolicyValidUntil DateTime? // Vigencia poliza RC

  // Hierarchy
  reportsToId  String?
  reportsTo    User?   @relation("Hierarchy", fields: [reportsToId], references: [id])
  subordinates User[]  @relation("Hierarchy")

  // Integraciones IA (Agentes)
  googleAccessToken  String?
  googleRefreshToken String?
  googleTokenExpiry  DateTime?
  
  // ElevenLabs Voice Integration
  voiceSecondsBalance Int @default(300) // 5 minutos de capa gratuita inicial
  InteractionLog     InteractionLog[]
  Meeting            Meeting[]
  Task               Task[]
  FeedbackSurvey     FeedbackSurvey[]

  // For Double Promotoria or shared access (Simple implementation: Secondary access list)
  // This could be a many-to-many relation if needed

  // Data
  dailyRecords      DailyRecord[]
  activityLogs      ActivityLog[]
  policies          Policy[]
  clients           Client[]
  adnDiagnostics    AdnDiagnostic[]
  cotizaciones      Cotizacion[]
  pushSubscriptions PushSubscription[]
  agentReviews      PerformanceReview[] @relation("AgentReviews")
  evaluatedReviews  PerformanceReview[] @relation("EvaluatedReviews")
  tickets           Ticket[]

  // Billing
  isSelfPaid           Boolean @default(false)
  stripeCustomerId     String?
  stripeSubscriptionId String?

  aiAgents        AIAgent[]
  FrequentContact FrequentContact[]

  pollVotes PollVote[]

  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  developmentProgress AgentDevelopmentProgress?

  // ElevenLabs Voice Details
  freeSecondsBalance   Int                    @default(300)
  lastFreeMinutesReset DateTime               @default(now())
  voicePurchases       VoiceMinutesPurchase[]
  CompanyProfile       CompanyProfile?
}

model VoiceMinutesPurchase {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seconds          Int      // Segundos comprados originalmente
  secondsRemaining Int      // Segundos que le quedan
  purchasedAt      DateTime @default(now())
  expiresAt        DateTime // purchasedAt + 90 días
}

model Activity {
  id           String        @id @default(cuid())
  name         String
  value        Int // Points value
  dailyRecords DailyRecord[]
}

model DailyRecord {
  id       String  @id @default(cuid())
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])
  userId   String
  user     User    @relation(fields: [userId], references: [id])

  activityId String
  activity   Activity @relation(fields: [activityId], references: [id])

  date    DateTime // Use Date part only in logic
  planned Int      @default(0)
  real    Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, activityId, date]) // One record per activity per user per day
}

model Client {
  id        String    @id @default(cuid())
  agencyId  String?
  agency    Agency?   @relation(fields: [agencyId], references: [id])
  name      String
  email     String?
  phone     String?
  birthDate DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  policies Policy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Policy {
  id       String  @id @default(cuid())
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  policyNumber String  @unique
  contractor   String? // Contratante
  insured      String? // Asegurado

  product          String?
  insuranceCompany String?

  effectiveDate    DateTime?
  renewalDate      DateTime?
  anniversaryDay   Int?
  anniversaryMonth Int?

  annualPremium Float?  @default(0)
  paymentMethod String?

  approximateCommission Float? @default(0)
  approximateBonus      Float? @default(0)

  observations String?

  pdfUrl String? // Vercel Blob URL

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Content {
  id       String  @id @default(cuid())
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  type     String // 'HOME_AD', 'LINK_BANNER'

  imageUrl String
  linkUrl  String? // For banners

  active Boolean @default(true)
  order  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyRules {
  id        String   @id @default(cuid())
  content   String // SQLite treats String as TEXT by default. invoke @db.Text is not needed/supported
  updatedAt DateTime @updatedAt
}

model Cotizacion {
  id             String   @id @default(cuid())
  agencyId       String?
  agency         Agency?  @relation(fields: [agencyId], references: [id])
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  cliente        String
  telefono       String
  agente         String
  producto       String
  primaAnual     Float
  totalPrima     Float
  ahorro         Float
  rendimiento    Float
  valorUdi       Float?
  inflacionUdi   Float?
  duracion       String?
  isr            Float?
  coberturas     String? // JSON string
  projectionData String? // JSON string
  createdAt      DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

model Agent {
  id        String   @id @default(cuid())
  agencyId  String?
  agency    Agency?  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@unique([name, agencyId])
}

model AdnDiagnostic {
  id       String  @id @default(cuid())
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])
  userId   String
  user     User    @relation(fields: [userId], references: [id])

  // Paso 0
  modalidad     String // 'DETALLADO' | 'RESUMIDO' | 'BASICO'
  cerradaPagada Boolean @default(false) // Nuevo: Propuesta cerrada/emitida y pagada

  // Paso 1: Perfil
  clienteNombre    String
  clienteEdad      Int
  conyugeNombre    String?
  conyugeEdad      Int?
  situacionLaboral String
  hijosData        String? // JSON string: [{nombre: string, edad: number}]

  // Salud y Hbitos
  estatura      String?
  peso          String?
  fumador       Boolean @default(false)
  padecimientos String?

  // Paso 2: Seguros Existentes
  hasSeguroAhorro  Boolean @default(false)
  ahorroAporte     Float?
  ahorroFrecuencia String? // 'MENSUAL' | 'ANUAL'

  hasPpr        Boolean @default(false)
  pprAporte     Float?
  pprFrecuencia String? // 'MENSUAL' | 'ANUAL'
  pprAniosPlazo String? // '10' | '15' | '20' | '65'

  hasGmm            Boolean @default(false)
  hasSeguroVida     Boolean @default(false)
  vidaSumaAsegurada Float?

  // Paso 3: Diagnóstico Financiero
  ingresosTotales Float
  ingresosNetos   Float
  ahorroActual    Float // Para cálculo de brecha de fondo de emergencia

  // Tarjetas de Crédito
  hasTarjetasCredito Boolean @default(false)
  tarjetasCuales     String?
  tarjetasLimite     String?

  // Gastos desglosados (Guardado en JSON por flexibilidad de modalidades)
  gastosData String // JSON string conteniendo rubros detallados o resumidos

  // Totales calculados
  totalGastos Float

  // Evidencia para modalidad BÁSICA
  evidenciaBase64 String?

  // GPS tracking
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id           String   @id @default(cuid())
  agencyId     String?
  agency       Agency?  @relation(fields: [agencyId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId   String // ID de la actividad del catálogo ('1' a '7')
  activityName String // Nombre descriptivo (ej: 'Cita agendada')
  points       Int // Puntos otorgados por la actividad
  prospectName String? // Nombre del prospecto (obligatorio para citas)
  dateStr      String // Fecha en formato 'YYYY-MM-DD' en hora de CDMX
  createdAt    DateTime @default(now())
}

model KnowledgeDocument {
  id               String   @id @default(cuid())
  agencyId         String?
  agency           Agency?  @relation(fields: [agencyId], references: [id])
  title            String
  content          String // Contenido de texto
  active           Boolean  @default(true)
  isGlobalTemplate Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScheduledPush {
  id          String   @id @default(cuid())
  message     String
  frequency   String
  timeHour    Int
  recipientId String
  runDate     String?
  createdAt   DateTime @default(now())
}

// ----------------------------------------------------------------------------
// Módulo de Biblioteca y Documentación
// ----------------------------------------------------------------------------

model DocumentPack {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents PackDocument[]
  agencies  AgencyDocumentPack[]
}

model PackDocument {
  id        String       @id @default(cuid())
  packId    String
  pack      DocumentPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  name      String
  fileUrl   String
  fileSize  Int          @default(0) // En bytes
  fileType  String?
  category  String       @default("Otros")
  createdAt DateTime     @default(now())
}

model AgencyDocumentPack {
  agencyId  String
  agency    Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  packId    String
  pack      DocumentPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  enabledAt DateTime     @default(now())

  @@id([agencyId, packId])
}

model AgencyDocument {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name      String
  fileUrl   String
  fileSize  Int      @default(0) // En bytes para calcular el limite de 80MB
  fileType  String?
  category  String   @default("Otros")
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// Módulo de Gestión de Desempeño (PEA/PRP)
// ----------------------------------------------------------------------------

model PerformanceReview {
  id          String  @id @default(cuid())
  agencyId    String?
  agency      Agency? @relation(fields: [agencyId], references: [id])
  agentId     String
  agent       User    @relation("AgentReviews", fields: [agentId], references: [id], onDelete: Cascade)
  evaluatorId String?
  evaluator   User?   @relation("EvaluatedReviews", fields: [evaluatorId], references: [id], onDelete: SetNull)

  status   String  @default("PENDING") // PENDING, REVIEWED, REJECTED
  feedback String? // Comentarios del Admin en caso de rechazo

  evalMonth String?
  evalWeek  String?

  metaPrimasMensual  Float
  avancePrimasActual Float
  puntosActividad    Int
  adnsRealizados     Int
  compromisos        String?

  aiAnalysisResult String? // Diagnóstico generado por el Motor de IA

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ticket {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  agencyId     String?
  agency       Agency?  @relation(fields: [agencyId], references: [id])
  subject      String
  description  String
  contactPhone String?
  status       String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Poll {
  id        String       @id @default(cuid())
  title     String
  question  String
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  options   PollOption[]
  votes     PollVote[]
}

model PollOption {
  id     String     @id @default(cuid())
  pollId String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text   String
  votes  PollVote[]
}

model PollVote {
  id       String     @id @default(cuid())
  pollId   String
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  agencyId String?
  agency   Agency?    @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

// Modelo temporal para corregir error de Prisma Drift en Vercel
model AIAgent {
  designStyle       String?          @default("Realista")
  id                String           @id @default(cuid())
  name              String           @default("Agente")
  type              String           @default("SOCIAL_MEDIA_MANAGER")
  systemPrompt      String?
  isActive          Boolean          @default(true)
  socialAccounts    String?
  toneUrl           String?
  useImprovedEngine Boolean          @default(false)
  guidelines        String?
  userId            String
  User              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @default(now()) @updatedAt
  DraftPost             DraftPost[]
  InteractionLog        InteractionLog[]

  // Límites mensuales
  imageGenerationsCount Int              @default(0)
  imageGenerationsReset DateTime         @default(now())
}

model DraftPost {
  id          String    @id @default(cuid())
  aiAgentId   String
  AIAgent     AIAgent   @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  content     String
  imageUrl    String?
  status      String    @default("DRAFT")
  platform    String
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model InteractionLog {
  id              String   @id @default(cuid())
  aiAgentId       String
  AIAgent         AIAgent  @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  userId          String
  User            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            String
  content         String   @db.Text
  toolInvocations Json?
  createdAt       DateTime @default(now())
}

model CompanyProfile {
  id              String    @id @default(cuid())
  userId          String?   @unique
  User            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryColor    String?   @default("#4f46e5")
  secondaryColor  String?   @default("#10b981")
  logoUrl         String?
  industry        String?
  targetAudience  String?
  websiteUrl      String?
  description     String?
  imagesGenerated Int       @default(0)
  quotaResetDate  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model KnowledgeAsset {
  id        String   @id @default(cuid())
  title     String
  content   String?
  url       String?
  type      String   @default("DOCUMENT")
  agentId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Meeting {
  id              String   @id @default(cuid())
  title           String
  date            String // YYYY-MM-DD
  time            String // HH:MM
  duration        Int // in minutes
  description     String?
  userId          String
  User            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEventId   String?
  googleEventLink String?
  googleMeetLink  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  completed   Boolean  @default(false)
  dueDate     String? // YYYY-MM-DD
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  userId      String
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// Módulo de Academia (Cédula A)
// ----------------------------------------------------------------------------

model Pregunta {
  id        Int     @id @default(autoincrement())
  number    Int
  module    String
  question  String
  options   Json
  correct   Int
  has_error Boolean @default(false)

  @@map("preguntas")
}

model EstudioProgreso {
  id                  Int       @id @default(autoincrement())
  email               String
  module              String
  tiempo_segundos     Int?      @default(0)
  pregunta_actual     Int?      @default(0)
  fecha_actualizacion DateTime? @default(now())

  @@unique([email, module])
  @@map("estudio_progreso")
}

model ExamenIntento {
  id                   Int       @id @default(autoincrement())
  email                String
  calificacion         Decimal
  aprobado             Boolean
  respuestas_correctas Int
  total_preguntas      Int
  detalles_modulos     Json?
  fecha                DateTime? @default(now())

  @@map("examen_intentos")
}

model EstudioLicencia {
  id               Int       @id @default(autoincrement())
  promotor_email   String
  agente_email     String
  dias_asignados   Int?      @default(0)
  fecha_asignacion DateTime? @default(now())
  fecha_expiracion DateTime?

  @@unique([promotor_email, agente_email])
  @@map("estudio_licencias")
}

model PromotorSaldo {
  promotor_email      String    @id
  dias_disponibles    Int?      @default(7)
  fecha_actualizacion DateTime? @default(now())

  @@map("promotor_saldos")
}

// Configuración de los días del plan de arranque para la agencia
model DevelopmentPlanDay {
  id       String @id @default(cuid())
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id])

  dayNumber             Int // Día 1, 2, 3...
  title                 String // Ej: "Curso Onboarding"
  instructions          String? // Instrucciones o metas del día
  videoUrl              String? // Enlace a YouTube u otro video
  fileUrl               String? // URL del PDF/PPT subido (Vercel Blob)
  fileName              String? // Nombre original del archivo
  additionalMediaJson   String? // Archivos y videos adicionales
  requiresAdminApproval Boolean @default(false) // El candado

  hasQuestionnaire      Boolean @default(false)
  questionnaireJson     String? // [{ question, options, correctOptionIndex }]
  minPassingScore       Int     @default(80)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agencyId, dayNumber])
}

// Progreso individual de cada agente
model AgentDevelopmentProgress {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  currentDayNumber Int    @default(1)
  status           String @default("IN_PROGRESS") // 'IN_PROGRESS', 'WAITING_APPROVAL', 'COMPLETED'

  latestScore           Int?
  latestAnswersJson     String? // Respuestas que eligió el agente
  questionnaireAttempts Int     @default(0)

  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Contactos frecuentes de la asistente
model FrequentContact {
  id        String   @id @default(cuid())
  name      String
  email     String
  userId    String
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, email])
}

model NewsArticle {
  id          String   @id @default(cuid())
  title       String   @unique
  description String?
  content     String?
  url         String
  imageUrl    String?
  sourceName  String?
  category    String   // "Mexico" o "Global"
  tags        String[] // ["Seguros", "CNSF", "Banxico", etc.]
  publishedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AppErrorLog {
  id        String   @id @default(cuid())
  message   String
  stack     String?  @db.Text
  path      String?
  userId    String?
  userName  String?
  agencyId  String?
  createdAt DateTime @default(now())
}

model FeedbackSurvey {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  rating      Int
  comments    String?  @db.Text
  canContact  Boolean  @default(false)
  createdAt   DateTime @default(now())
}
