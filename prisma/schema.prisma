generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// SQLite does not support Enums, so we use String validation in app logic
// enum Role { ... } replaced by Strings

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  image         String?
  role          String    @default("AGENTE") // Changed from Enum Role to String
  phone         String?   // Teléfono del usuario/agente
  active        Boolean   @default(true) // Estatus activo/inactivo para restringir acceso
  birthDate     DateTime? // Fecha de nacimiento del agente para overlay de cumpleaños
  mustChangePassword Boolean @default(false) // Flag de seguridad para forzar cambio de contraseña temporal
  
  // Redes Sociales (Opcional)
  instagram     String?
  facebook      String?
  linkedin      String?
  twitter       String?

  // Datos Adicionales (Opcional)
  insurances    String?   // Aseguradoras con las que trabaja
  favoriteBook  String?   // Libro favorito
  hobby         String?   // Pasatiempo

  // Hierarchy
  reportsToId   String?
  reportsTo     User?     @relation("Hierarchy", fields: [reportsToId], references: [id])
  subordinates  User[]    @relation("Hierarchy")

  // For Double Promotoria or shared access (Simple implementation: Secondary access list)
  // This could be a many-to-many relation if needed
  
  // Data
  dailyRecords  DailyRecord[]
  activityLogs  ActivityLog[]
  policies      Policy[]
  adnDiagnostics AdnDiagnostic[]
  pushSubscriptions PushSubscription[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Activity {
  id          String        @id @default(cuid())
  name        String
  value       Int           // Points value
  dailyRecords DailyRecord[]
}

model DailyRecord {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  
  activityId  String
  activity    Activity  @relation(fields: [activityId], references: [id])
  
  date        DateTime  // Use Date part only in logic
  planned     Int       @default(0)
  real        Int       @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, activityId, date]) // One record per activity per user per day
}

model Policy {
  id            String    @id @default(cuid())
  
  policyNumber  String    @unique
  contractor    String    // Contratante
  insured       String    // Asegurado
  paymentMethod String
  renewalDate   DateTime
  
  pdfUrl        String?   // GCS URL
  
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Indexed for search performance (trigram indices would be added in raw SQL migration usually)
}

model Content {
  id        String   @id @default(cuid())
  type      String   // 'HOME_AD', 'LINK_BANNER'
  
  imageUrl  String
  linkUrl   String?  // For banners
  
  active    Boolean  @default(true)
  order     Int      @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyRules {
  id        String   @id @default(cuid())
  content   String   // SQLite treats String as TEXT by default. invoke @db.Text is not needed/supported
  updatedAt DateTime @updatedAt
}

model Cotizacion {
  id             String   @id @default(cuid())
  cliente        String
  telefono       String
  agente         String
  producto       String
  primaAnual     Float
  totalPrima     Float
  ahorro         Float
  rendimiento    Float
  valorUdi       Float?
  inflacionUdi   Float?
  duracion       String?
  isr            Float?
  coberturas     String?  // JSON string
  projectionData String?  // JSON string
  createdAt      DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

model Agent {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model AdnDiagnostic {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  
  // Paso 0
  modalidad        String   // 'DETALLADO' | 'RESUMIDO' | 'BASICO'
  cerradaPagada    Boolean  @default(false) // Nuevo: Propuesta cerrada/emitida y pagada
  
  // Paso 1: Perfil
  clienteNombre    String
  clienteEdad      Int
  conyugeNombre    String?
  conyugeEdad      Int?
  situacionLaboral String
  hijosData        String?  // JSON string: [{nombre: string, edad: number}]
  
  // Paso 2: Seguros Existentes
  hasSeguroAhorro  Boolean  @default(false)
  ahorroAporte     Float?
  ahorroFrecuencia String?  // 'MENSUAL' | 'ANUAL'
  
  hasPpr           Boolean  @default(false)
  pprAporte        Float?
  pprFrecuencia    String?  // 'MENSUAL' | 'ANUAL'
  pprAniosPlazo    String?  // '10' | '15' | '20' | '65'
  
  hasGmm           Boolean  @default(false)
  hasSeguroVida    Boolean  @default(false)
  vidaSumaAsegurada Float?
  
  // Paso 3: Diagnóstico Financiero
  ingresosTotales  Float
  ingresosNetos    Float
  ahorroActual     Float    // Para cálculo de brecha de fondo de emergencia
  
  // Gastos desglosados (Guardado en JSON por flexibilidad de modalidades)
  gastosData       String   // JSON string conteniendo rubros detallados o resumidos
  
  // Totales calculados
  totalGastos      Float
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ActivityLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId   String   // ID de la actividad del catálogo ('1' a '7')
  activityName String   // Nombre descriptivo (ej: 'Cita agendada')
  points       Int      // Puntos otorgados por la actividad
  prospectName String?  // Nombre del prospecto (obligatorio para citas)
  dateStr      String   // Fecha en formato 'YYYY-MM-DD' en hora de CDMX
  createdAt    DateTime @default(now())
}

model KnowledgeDocument {
  id        String   @id @default(cuid())
  title     String
  content   String   // Contenido de texto
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
