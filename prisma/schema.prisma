generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CommissionLedger {
  id                 String   @id @default(cuid())
  sellerId           String
  agencyId           String?
  stripeChargeId     String?
  description        String
  originalPrice      Float
  amountPaid         Float
  discountPercentage Float
  commissionEarned   Float
  status             String   @default("PENDING")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  level              Int      @default(1)
  sourceAgencyId     String?
  seller             User     @relation("SellerCommissions", fields: [sellerId], references: [id])

  @@index([sellerId])
  @@index([agencyId])
}

model Agency {
  id                    String               @id @default(cuid())
  name                  String
  slug                  String               @unique
  logoUrl               String?
  primaryColor          String?              @default("#4f46e5")
  secondaryColor        String?
  stripeCustomerId      String?
  subscriptionStatus    String?              @default("active")
  subscriptionEndDate   DateTime?
  referredByAgencyId    String?
  active                Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  discountLocked        Boolean?             @default(false)
  purchasedSeats        Int                  @default(0)
  referredById          String?
  allowLiteAgents       Boolean              @default(false)
  enableWhatsAppPlanner Boolean              @default(false)
  whatsAppPlannerAgents String?
  whatsAppPlannerPhones String?
  allowReferidores      Boolean              @default(false)
  activityLogs          ActivityLog[]
  adnDiagnostics        AdnDiagnostic[]
  referrer              User?                @relation("AgencyReferrer", fields: [referredById], references: [id])
  agencyDocuments       AgencyDocument[]
  documentPacks         AgencyDocumentPack[]
  autocompleteAgents    Agent[]
  clients               Client[]
  contents              Content[]
  cotizaciones          Cotizacion[]
  dailyRecords          DailyRecord[]
  DevelopmentPlanDay    DevelopmentPlanDay[]
  knowledgeDocuments    KnowledgeDocument[]
  performanceReviews    PerformanceReview[]
  policies              Policy[]
  pollVotes             PollVote[]
  tickets               Ticket[]
  users                 User[]

  @@index([referredById])
}

model DiscountCode {
  id                 String    @id @default(cuid())
  code               String    @unique
  discountPercentage Float
  maxUses            Int?
  uses               Int       @default(0)
  expiresAt          DateTime?
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sellerId           String?
  seller             User?     @relation("SellerDiscountCodes", fields: [sellerId], references: [id])

  @@index([sellerId])
}

model User {
  id                   String                    @id @default(cuid())
  name                 String?
  email                String                    @unique
  password             String?
  image                String?
  role                 String                    @default("AGENTE")
  reportsToId          String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  active               Boolean                   @default(true)
  phone                String?
  birthDate            DateTime?
  facebook             String?
  favoriteBook         String?
  hobby                String?
  instagram            String?
  insurances           String?
  linkedin             String?
  twitter              String?
  mustChangePassword   Boolean                   @default(false)
  agencyId             String?
  googleAccessToken    String?
  googleRefreshToken   String?
  googleTokenExpiry    DateTime?
  isSelfPaid           Boolean                   @default(false)
  phoneVerified        Boolean                   @default(false)
  resetToken           String?                   @unique
  resetTokenExpiry     DateTime?
  sellerCommissionRate Float?                    @default(40)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  termsAccepted        Boolean                   @default(false)
  termsAcceptedAt      DateTime?
  brandColor           String?
  brandLogo            String?
  voiceSecondsBalance  Int                       @default(300)
  freeSecondsBalance   Int                       @default(300)
  lastFreeMinutesReset DateTime                  @default(now())
  cedulaValidUntil     DateTime?
  promotoriaJoinDate   DateTime?
  rcPolicyValidUntil   DateTime?
  linkedAgentId        String?
  aiAgents             AIAgent[]
  activityLogs         ActivityLog[]
  adnDiagnostics       AdnDiagnostic[]
  referredAgencies     Agency[]                  @relation("AgencyReferrer")
  developmentProgress  AgentDevelopmentProgress?
  clients              Client[]
  commissions          CommissionLedger[]        @relation("SellerCommissions")
  CompanyProfile       CompanyProfile?
  cotizaciones         Cotizacion[]
  dailyRecords         DailyRecord[]
  discountCodes        DiscountCode[]            @relation("SellerDiscountCodes")
  FeedbackSurvey       FeedbackSurvey[]
  FrequentContact      FrequentContact[]
  InteractionLog       InteractionLog[]
  Meeting              Meeting[]
  agentReviews         PerformanceReview[]       @relation("AgentReviews")
  evaluatedReviews     PerformanceReview[]       @relation("EvaluatedReviews")
  policies             Policy[]
  pollVotes            PollVote[]
  pushSubscriptions    PushSubscription[]
  Task                 Task[]
  tickets              Ticket[]
  agency               Agency?                   @relation(fields: [agencyId], references: [id])
  linkedAgent          User?                     @relation("AgentReferidores", fields: [linkedAgentId], references: [id])
  referidores          User[]                    @relation("AgentReferidores")
  reportsTo            User?                     @relation("Hierarchy", fields: [reportsToId], references: [id])
  subordinates         User[]                    @relation("Hierarchy")
  voicePurchases       VoiceMinutesPurchase[]

  @@index([agencyId])
  @@index([reportsToId])
}

model VoiceMinutesPurchase {
  id               String   @id @default(cuid())
  userId           String
  seconds          Int
  secondsRemaining Int
  purchasedAt      DateTime @default(now())
  expiresAt        DateTime
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Activity {
  id           String        @id @default(cuid())
  name         String
  value        Int
  dailyRecords DailyRecord[]
}

model DailyRecord {
  id         String   @id @default(cuid())
  userId     String
  activityId String
  date       DateTime
  planned    Int      @default(0)
  real       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  agencyId   String?
  activity   Activity @relation(fields: [activityId], references: [id])
  agency     Agency?  @relation(fields: [agencyId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, activityId, date])
}

model Client {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  birthDate DateTime?
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  agencyId  String?
  agency    Agency?   @relation(fields: [agencyId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  policies  Policy[]

  @@index([agencyId])
  @@index([userId])
}

model Policy {
  id                    String    @id @default(cuid())
  policyNumber          String    @unique
  contractor            String?
  insured               String?
  paymentMethod         String?
  renewalDate           DateTime?
  pdfUrl                String?
  userId                String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  anniversaryDay        Int?
  anniversaryMonth      Int?
  annualPremium         Float?    @default(0)
  approximateBonus      Float?    @default(0)
  approximateCommission Float?    @default(0)
  clientId              String?
  effectiveDate         DateTime?
  insuranceCompany      String?
  observations          String?
  product               String?
  agencyId              String?
  agency                Agency?   @relation(fields: [agencyId], references: [id])
  client                Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user                  User      @relation(fields: [userId], references: [id])

  @@index([agencyId])
  @@index([clientId])
  @@index([userId])
}

model Content {
  id        String   @id @default(cuid())
  type      String
  imageUrl  String
  linkUrl   String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agencyId  String?
  agency    Agency?  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
}

model CompanyRules {
  id        String   @id @default(cuid())
  content   String
  updatedAt DateTime @updatedAt
}

model Cotizacion {
  id             String   @id @default(cuid())
  cliente        String
  telefono       String
  agente         String
  producto       String
  primaAnual     Float
  totalPrima     Float
  ahorro         Float
  rendimiento    Float
  valorUdi       Float?
  inflacionUdi   Float?
  duracion       String?
  isr            Float?
  coberturas     String?
  projectionData String?
  createdAt      DateTime @default(now())
  userId         String?
  agencyId       String?
  agency         Agency?  @relation(fields: [agencyId], references: [id])
  user           User?    @relation(fields: [userId], references: [id])

  @@index([agencyId])
  @@index([userId])
}

model Setting {
  key   String @id
  value String
}

model Agent {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  agencyId  String?
  agency    Agency?  @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([name, agencyId])
}

model AdnDiagnostic {
  id                 String   @id @default(cuid())
  userId             String
  modalidad          String
  clienteNombre      String
  clienteEdad        Int
  conyugeNombre      String?
  conyugeEdad        Int?
  situacionLaboral   String
  hijosData          String?
  hasSeguroAhorro    Boolean  @default(false)
  ahorroAporte       Float?
  ahorroFrecuencia   String?
  hasPpr             Boolean  @default(false)
  pprAporte          Float?
  pprFrecuencia      String?
  hasGmm             Boolean  @default(false)
  hasSeguroVida      Boolean  @default(false)
  ingresosTotales    Float
  ingresosNetos      Float
  ahorroActual       Float
  gastosData         String
  totalGastos        Float
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  pprAniosPlazo      String?
  vidaSumaAsegurada  Float?
  cerradaPagada      Boolean  @default(false)
  evidenciaBase64    String?
  latitude           Float?
  longitude          Float?
  estatura           String?
  fumador            Boolean  @default(false)
  hasTarjetasCredito Boolean  @default(false)
  padecimientos      String?
  peso               String?
  tarjetasCuales     String?
  tarjetasLimite     String?
  agencyId           String?
  agency             Agency?  @relation(fields: [agencyId], references: [id])
  user               User     @relation(fields: [userId], references: [id])
}

model ActivityLog {
  id           String   @id @default(cuid())
  userId       String
  activityId   String
  activityName String
  points       Int
  prospectName String?
  dateStr      String
  createdAt    DateTime @default(now())
  agencyId     String?
  agency       Agency?  @relation(fields: [agencyId], references: [id])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@index([userId])
  @@index([dateStr])
}

model KnowledgeDocument {
  id               String   @id @default(cuid())
  title            String
  content          String
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  agencyId         String?
  isGlobalTemplate Boolean  @default(false)
  agency           Agency?  @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ScheduledPush {
  id          String   @id @default(cuid())
  message     String
  frequency   String
  timeHour    Int
  recipientId String
  runDate     String?
  createdAt   DateTime @default(now())
}

model DocumentPack {
  id          String               @id @default(cuid())
  name        String
  description String?
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  agencies    AgencyDocumentPack[]
  documents   PackDocument[]
}

model PackDocument {
  id        String       @id @default(cuid())
  packId    String
  name      String
  fileUrl   String
  fileSize  Int          @default(0)
  fileType  String?
  createdAt DateTime     @default(now())
  category  String       @default("Otros")
  pack      DocumentPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([packId])
}

model AgencyDocumentPack {
  agencyId  String
  packId    String
  enabledAt DateTime     @default(now())
  agency    Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  pack      DocumentPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@id([agencyId, packId])
}

model AgencyDocument {
  id        String   @id @default(cuid())
  agencyId  String
  name      String
  fileUrl   String
  fileSize  Int      @default(0)
  fileType  String?
  createdAt DateTime @default(now())
  category  String   @default("Otros")
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
}

model PerformanceReview {
  id                 String   @id @default(cuid())
  agencyId           String?
  agentId            String
  evaluatorId        String?
  status             String   @default("PENDING")
  feedback           String?
  evalMonth          String?
  evalWeek           String?
  metaPrimasMensual  Float
  avancePrimasActual Float
  puntosActividad    Int
  adnsRealizados     Int
  compromisos        String?
  aiAnalysisResult   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  agency             Agency?  @relation(fields: [agencyId], references: [id])
  agent              User     @relation("AgentReviews", fields: [agentId], references: [id], onDelete: Cascade)
  evaluator          User?    @relation("EvaluatedReviews", fields: [evaluatorId], references: [id])

  @@index([agencyId])
  @@index([agentId])
  @@index([evaluatorId])
}

model Ticket {
  id           String   @id @default(cuid())
  userId       String
  agencyId     String?
  subject      String
  description  String
  contactPhone String?
  status       String   @default("OPEN")
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  agency       Agency?  @relation(fields: [agencyId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([agencyId])
}

model Poll {
  id        String       @id @default(cuid())
  title     String
  question  String
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  options   PollOption[]
  votes     PollVote[]
}

model PollOption {
  id     String     @id @default(cuid())
  pollId String
  text   String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]

  @@index([pollId])
}

model PollVote {
  id       String     @id @default(cuid())
  pollId   String
  optionId String
  userId   String
  agencyId String?
  agency   Agency?    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([optionId])
  @@index([agencyId])
}

model AIAgent {
  designStyle           String?          @default("Realista")
  id                    String           @id @default(cuid())
  name                  String           @default("Agente")
  type                  String           @default("SOCIAL_MEDIA_MANAGER")
  systemPrompt          String?
  isActive              Boolean          @default(true)
  socialAccounts        String?
  toneUrl               String?
  useImprovedEngine     Boolean          @default(false)
  guidelines            String?
  userId                String
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @default(now()) @updatedAt
  imageGenerationsCount Int              @default(0)
  imageGenerationsReset DateTime         @default(now())
  User                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  DraftPost             DraftPost[]
  InteractionLog        InteractionLog[]

  @@index([userId])
}

model DraftPost {
  id          String    @id @default(cuid())
  aiAgentId   String
  content     String
  imageUrl    String?
  status      String    @default("DRAFT")
  platform    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  scheduledAt DateTime?
  AIAgent     AIAgent   @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)

  @@index([aiAgentId])
}

model InteractionLog {
  id              String   @id @default(cuid())
  aiAgentId       String
  userId          String
  role            String
  content         String
  toolInvocations Json?
  createdAt       DateTime @default(now())
  AIAgent         AIAgent  @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  User            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([aiAgentId])
  @@index([userId])
}

model CompanyProfile {
  id              String    @id @default(cuid())
  industry        String?
  targetAudience  String?
  websiteUrl      String?
  description     String?
  imagesGenerated Int       @default(0)
  quotaResetDate  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  logoUrl         String?
  primaryColor    String?   @default("#4f46e5")
  secondaryColor  String?   @default("#10b981")
  userId          String?   @unique
  User            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model KnowledgeAsset {
  id        String   @id @default(cuid())
  title     String
  content   String?
  url       String?
  type      String   @default("DOCUMENT")
  agentId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
}

model Meeting {
  id              String   @id @default(cuid())
  title           String
  date            String
  time            String
  duration        Int
  description     String?
  userId          String
  googleEventId   String?
  googleEventLink String?
  googleMeetLink  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  User            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  completed   Boolean  @default(false)
  dueDate     String?
  priority    String   @default("MEDIUM")
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Pregunta {
  id        Int     @id @default(autoincrement())
  number    Int
  module    String
  question  String
  options   Json
  correct   Int
  has_error Boolean @default(false)

  @@map("preguntas")
}

model EstudioProgreso {
  id                  Int       @id @default(autoincrement())
  email               String
  module              String
  tiempo_segundos     Int?      @default(0)
  pregunta_actual     Int?      @default(0)
  fecha_actualizacion DateTime? @default(now())

  @@unique([email, module])
  @@map("estudio_progreso")
}

model ExamenIntento {
  id                   Int       @id @default(autoincrement())
  email                String
  calificacion         Decimal
  aprobado             Boolean
  respuestas_correctas Int
  total_preguntas      Int
  detalles_modulos     Json?
  fecha                DateTime? @default(now())

  @@index([email])
  @@map("examen_intentos")
}

model EstudioLicencia {
  id               Int       @id @default(autoincrement())
  promotor_email   String
  agente_email     String
  dias_asignados   Int?      @default(0)
  fecha_asignacion DateTime? @default(now())
  fecha_expiracion DateTime?

  @@unique([promotor_email, agente_email])
  @@map("estudio_licencias")
}

model PromotorSaldo {
  promotor_email      String    @id
  dias_disponibles    Int?      @default(7)
  fecha_actualizacion DateTime? @default(now())

  @@map("promotor_saldos")
}

model DevelopmentPlanDay {
  id                    String   @id @default(cuid())
  agencyId              String
  dayNumber             Int
  title                 String
  instructions          String?
  videoUrl              String?
  fileUrl               String?
  fileName              String?
  requiresAdminApproval Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  hasQuestionnaire      Boolean  @default(false)
  minPassingScore       Int      @default(80)
  questionnaireJson     String?
  additionalMediaJson   String?
  agency                Agency   @relation(fields: [agencyId], references: [id])

  @@unique([agencyId, dayNumber])
}

model AgentDevelopmentProgress {
  id                    String   @id @default(cuid())
  userId                String   @unique
  currentDayNumber      Int      @default(1)
  status                String   @default("IN_PROGRESS")
  startedAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  latestAnswersJson     String?
  latestScore           Int?
  questionnaireAttempts Int      @default(0)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FrequentContact {
  id        String   @id @default(cuid())
  name      String
  email     String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
}

model NewsArticle {
  id          String   @id @default(cuid())
  title       String   @unique
  description String?
  content     String?
  url         String
  imageUrl    String?
  sourceName  String?
  category    String
  tags        String[]
  publishedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AppErrorLog {
  id        String   @id @default(cuid())
  message   String
  stack     String?
  path      String?
  userId    String?
  userName  String?
  agencyId  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([agencyId])
}

model FeedbackSurvey {
  id         String   @id @default(cuid())
  userId     String
  rating     Int
  comments   String?
  canContact Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
}
